			"name": "T06 GET /media",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200 + tableau', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });",
							"const m = pm.response.json();",
							"pm.test('champs id,title,slug,date,mediaType', function () { if (m.length) ['id','title','slug','date','mediaType'].forEach(k => pm.expect(m[0]).to.have.property(k)); });",
							"pm.test('tri par date decroissante', function () {",
							"  for (let i = 1; i < m.length; i++) pm.expect(new Date(m[i-1].date) >= new Date(m[i].date)).to.eql(true);",
							"});"
						]
					}
				}
