						"exec": [
							"pm.test('200 + tableau JSON', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });",
							"const r = pm.response.json();",
							"pm.test('au moins un resultat', function () { pm.expect(r.length).to.be.above(0); });",
							"pm.test('champs id,title,excerpt,date,path,source', function () {",
							"  ['id','title','excerpt','date','path','source'].forEach(k => pm.expect(r[0]).to.have.property(k));",
