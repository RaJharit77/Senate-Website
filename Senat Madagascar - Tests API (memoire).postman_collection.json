	"item": [
		{
			"name": "T01 GET /senators",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200 + JSON', function () { pm.response.to.have.status(200); pm.response.to.be.json; });",
							"const j = pm.response.json();",
							"pm.test('success = true', function () { pm.expect(j.success).to.eql(true); });",
							"pm.test('data contient senateurs, bureau, commissions, provinces', function () {",
							"  ['senateurs','bureau','commissions','provinces'].forEach(k => pm.expect(j.data).to.have.property(k));",
							"});",
							"pm.test('meta.count = nombre de senateurs', function () { pm.expect(j.meta.count).to.eql(j.data.senateurs.length); });",
							"pm.test('Cache-Control public s-maxage=3600', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('s-maxage=3600'); });"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/senators",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"senators"
					]
				}
			},
			"response": []
		},
