	"item": [
		{
			"name": "S1 Recherche – mot-clé valide",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Statut 200', () => pm.response.to.have.status(200));",
							"pm.test('Tableau non vide', () => { const j = pm.response.json(); pm.expect(j).to.be.an('array').that.is.not.empty; });",
							"pm.test('Champs id/title/path/source', () => pm.response.json().forEach(x => pm.expect(x).to.include.keys('id','title','path','source')));",
							"pm.test('Temps < 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/search?q=senat",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"search"
					],
					"query": [
						{
							"key": "q",
							"value": "senat"
						}
					]
				}
			},
			"response": []
		},
