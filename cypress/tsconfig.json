{
    "compilerOptions": {
        "target": "ES2019",
        "lib": [
            "es2019",
            "dom"
        ],
        "types": [
            "cypress",
            "node",
            "cypress-axe"
        ],
        "module": "commonjs",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "paths": {
            "@/*": [
                "../*"
            ],
            "*": [
                "./*"
            ]
        }
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}